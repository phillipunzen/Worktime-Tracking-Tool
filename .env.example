# ---------------------------------------------------------------
# Kopieren nach .env und Werte anpassen!
# ---------------------------------------------------------------

# Port, unter dem die Web-Oberfläche auf dem Host erreichbar ist
APP_PORT=8080

# Name, der in der Oberfläche und auf den PDFs erscheint
COMPANY_NAME=Meine Firma GmbH

# Zufälliger, langer Schlüssel für Sitzungen – z. B. erzeugen mit:
#   openssl rand -hex 32
SECRET_KEY=bitte-aendern

# Zeitzone
TZ=Europe/Berlin

# Erster Administrator (wird nur beim allerersten Start angelegt;
# das Passwort muss beim ersten Login geändert werden)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Dürfen Mitarbeiter ihre eigenen Zeiten nachtragen/korrigieren? (true/false)
# Vorgesetzte und Admins dürfen das immer. Alle Änderungen werden protokolliert.
ALLOW_SELF_EDIT=true

# --- MySQL (docker-compose.yml) --------------------------------
MYSQL_DATABASE=zeiterfassung
MYSQL_USER=zeiterfassung
MYSQL_PASSWORD=bitte-aendern
MYSQL_ROOT_PASSWORD=bitte-aendern-root

# --- MSSQL (docker-compose.mssql.yml) --------------------------
# Muss die SQL-Server-Komplexitätsregeln erfüllen (Groß/klein/Ziffer/Sonderzeichen, >= 8 Zeichen)
MSSQL_SA_PASSWORD=Bitte-Aendern-123
MSSQL_DATABASE=zeiterfassung

# --- Hinter einem Reverse-Proxy (nginx, Traefik, Caddy …) mit HTTPS
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false

# --- Optional: E-Mail-Benachrichtigungen bei Urlaubsanträgen -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_FROM=
